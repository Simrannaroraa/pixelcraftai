# PixelCraft AI — Environment Configuration Example
# Copy this file to .env to configure local parameters.
# NOTE: The application operates 100% offline with ZERO paid credits required.

# Maximum upload size in megabytes
MAX_UPLOAD_SIZE_MB=15.0

# Database path (optional, defaults to data/image_editor.db)
# SQLITE_DB_PATH=data/image_editor.db

# Optional Cloud Generative Providers (Leave blank to use ₹0 local AI)
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
